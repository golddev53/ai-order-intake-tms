# Copy to .env. The defaults run everything against the local sandbox (no API keys needed).

# Encrypts credentials stored in n8n. Set once and keep it; changing it locks out saved credentials.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- TMS ---------------------------------------------------------------------
TMS_BASE_URL=http://sandbox:8000
TMS_API_KEY=demo-tms-key
# Where reviewers open shipments in a browser (links in Slack)
TMS_UI_URL=http://localhost:8000

# --- AI (any OpenAI-compatible endpoint) ----------------------------------------
OPENAI_BASE_URL=http://sandbox:8000/v1
OPENAI_API_KEY=sk-sandbox
OPENAI_MODEL=gpt-4o-mini

# --- Address validation (Google Geocoding API) ---------------------------------
GOOGLE_MAPS_BASE_URL=http://sandbox:8000
GOOGLE_MAPS_API_KEY=sandbox

# --- Notifications ---------------------------------------------------------------
SLACK_WEBHOOK_URL=http://sandbox:8000/mock/slack
SENDGRID_BASE_URL=http://sandbox:8000/mock/sendgrid
SENDGRID_API_KEY=sandbox
FROM_EMAIL=dispatch@example.com
FROM_NAME=Dispatch Team

# --- Review links ------------------------------------------------------------------
# Signs the Approve / Reject links in Slack. Use a long random value in production.
REVIEW_SIGNING_SECRET=change-me-to-a-long-random-string

# --- Business rules ------------------------------------------------------------
AUTO_APPROVE_MIN_CONFIDENCE=0.85
AUTO_APPROVE_MAX_PRICE=1500
GENERIC_TIMEZONE=America/Los_Angeles

# Pickup used for store orders (Shopify) that only have a delivery address
DEFAULT_PICKUP_NAME=Main Warehouse
DEFAULT_PICKUP_STREET=85 Saratoga Ave
DEFAULT_PICKUP_CITY=Santa Clara
DEFAULT_PICKUP_STATE=CA
DEFAULT_PICKUP_ZIP=95051

# --- Production example ----------------------------------------------------------
# TMS_BASE_URL=https://api.your-tms.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com
# GOOGLE_MAPS_API_KEY=AIza...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SENDGRID_BASE_URL=https://api.sendgrid.com
# SENDGRID_API_KEY=SG....
